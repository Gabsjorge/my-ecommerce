# Dev environment (copied to .env by `make up`). Never commit .env.
POSTGRES_USER=ecommerce
# URL-encode special characters if you change the password (it is used inside DATABASE_URL).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecommerce
# Do not change BACKEND_PORT without updating frontend/nginx.conf.
BACKEND_PORT=3000
FRONTEND_PORT=8080
# 5433 avoids clashing with a local Postgres on 5432.
DB_PORT=5433
TEST_LOCAL_FRONTEND_PORT=8081
# Seconds of inactivity before a cart is considered abandoned.
CART_INACTIVITY_TIMEOUT_SECONDS=600
